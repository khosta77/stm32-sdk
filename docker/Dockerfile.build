FROM ubuntu:24.04

# Single source of truth for the pinned ARM toolchain version. C++20 module
# dependency scanning needs GCC >= 14 (-fdeps-format=p1689r5); 13.x silently
# fails to scan `import`, so 13.2 was a latent break for module builds.
ARG ARM_GCC_VERSION=15.2.Rel1

# gcc-15/g++-15 (x86) are for the host unit-test build (tests/host); the ARM
# cross-toolchain below is for firmware. GCC 15 (not 14) is required: g++-14
# miscompiles C++20 modules that include <cstddef> in the global module fragment
# (redefinition of std::__byte_operand), which the SDK modules do. noble ships
# only g++-14, so g++-15 comes from the ubuntu-toolchain-r/test PPA.
RUN apt-get update && apt-get install -y --no-install-recommends \
        software-properties-common \
    && add-apt-repository -y ppa:ubuntu-toolchain-r/test \
    && apt-get update && apt-get install -y --no-install-recommends \
        cmake make ninja-build wget xz-utils ca-certificates python3 python3-pip git \
        gcc-15 g++-15 \
    && update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-15 100 \
    && update-alternatives --install /usr/bin/g++ g++ /usr/bin/g++-15 100 \
    && rm -rf /var/lib/apt/lists/*

# Download the ARM toolchain matching the image's host architecture, so the
# image is multi-arch: on amd64 (CI) the x86_64 build, on arm64 (Apple Silicon)
# the aarch64 build -- the latter runs natively instead of crashing under
# Rosetta. `uname -m` reflects the target platform (buildx emulates the RUN).
# Download from the Arm CDN blob directly (the developer.arm.com redirect host
# does not resolve inside some Docker DNS setups). The blob path lowercases the
# version (15.2.Rel1 -> 15.2.rel1).
RUN ARM_GCC_LC="$(echo "${ARM_GCC_VERSION}" | tr '[:upper:]' '[:lower:]')" \
    && case "$(uname -m)" in \
         x86_64)  HOST_ARCH=x86_64 ;; \
         aarch64) HOST_ARCH=aarch64 ;; \
         *) echo "unsupported host arch $(uname -m)" >&2; exit 1 ;; \
       esac \
    && wget -q --retry-connrefused --tries=5 --timeout=120 --waitretry=5 \
    "https://armkeil.blob.core.windows.net/developer/files/downloads/gnu/${ARM_GCC_LC}/binrel/arm-gnu-toolchain-${ARM_GCC_LC}-${HOST_ARCH}-arm-none-eabi.tar.xz" \
    -O /tmp/gcc-arm.tar.xz \
    && mkdir -p /opt/gcc-arm \
    && tar xf /tmp/gcc-arm.tar.xz -C /opt/gcc-arm --strip-components=1 \
    && rm /tmp/gcc-arm.tar.xz

ENV PATH="/opt/gcc-arm/bin:${PATH}"

# Bake the pinned FreeRTOS-Kernel so builds never re-clone it per project (#47).
# Keep FREERTOS_KERNEL_VERSION in sdk/cmake/stm32_rtos.cmake in sync with this tag.
ARG FREERTOS_KERNEL_VERSION=V11.1.0
RUN git clone --depth 1 -b "${FREERTOS_KERNEL_VERSION}" \
    https://github.com/FreeRTOS/FreeRTOS-Kernel.git /opt/freertos-kernel
ENV FETCHCONTENT_SOURCE_DIR_FREERTOS_KERNEL=/opt/freertos-kernel

WORKDIR /workspace
