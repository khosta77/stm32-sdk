FROM ubuntu:24.04

# Single source of truth for the pinned ARM toolchain version. C++20 module
# dependency scanning needs GCC >= 14 (-fdeps-format=p1689r5); 13.x silently
# fails to scan `import`, so 13.2 was a latent break for module builds.
ARG ARM_GCC_VERSION=15.2.Rel1

# gcc-14/g++-14 (x86) are for the host unit-test build (tests/host); the ARM
# cross-toolchain below is for firmware. ubuntu:24.04 (noble) ships g++-14 in
# the archive, so no PPA is needed.
RUN apt-get update && apt-get install -y --no-install-recommends \
    cmake make ninja-build wget xz-utils ca-certificates python3 python3-pip git \
    gcc-14 g++-14 \
    && update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-14 100 \
    && update-alternatives --install /usr/bin/g++ g++ /usr/bin/g++-14 100 \
    && rm -rf /var/lib/apt/lists/*

RUN wget -q "https://developer.arm.com/-/media/Files/downloads/gnu/${ARM_GCC_VERSION}/binrel/arm-gnu-toolchain-${ARM_GCC_VERSION}-x86_64-arm-none-eabi.tar.xz" \
    -O /tmp/gcc-arm.tar.xz \
    && mkdir -p /opt/gcc-arm \
    && tar xf /tmp/gcc-arm.tar.xz -C /opt/gcc-arm --strip-components=1 \
    && rm /tmp/gcc-arm.tar.xz

ENV PATH="/opt/gcc-arm/bin:${PATH}"

# Bake the pinned FreeRTOS-Kernel so builds never re-clone it per project (#47).
# Keep FREERTOS_KERNEL_VERSION in sdk/cmake/stm32_rtos.cmake in sync with this tag.
ARG FREERTOS_KERNEL_VERSION=V11.1.0
RUN git clone --depth 1 -b "${FREERTOS_KERNEL_VERSION}" \
    https://github.com/FreeRTOS/FreeRTOS-Kernel.git /opt/freertos-kernel
ENV FETCHCONTENT_SOURCE_DIR_FREERTOS_KERNEL=/opt/freertos-kernel

WORKDIR /workspace
