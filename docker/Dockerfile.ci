FROM ubuntu:24.04

# Keep in sync with Dockerfile.build (single source of truth for the pinned
# ARM toolchain). GCC >= 14 is required for C++20 module scanning.
ARG ARM_GCC_VERSION=15.2.Rel1

RUN apt-get update && apt-get install -y --no-install-recommends \
    cmake make ninja-build wget xz-utils ca-certificates git \
    gcc-14 g++-14 \
    && update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-14 100 \
    && update-alternatives --install /usr/bin/g++ g++ /usr/bin/g++-14 100 \
    && rm -rf /var/lib/apt/lists/*

RUN wget -q "https://developer.arm.com/-/media/Files/downloads/gnu/${ARM_GCC_VERSION}/binrel/arm-gnu-toolchain-${ARM_GCC_VERSION}-x86_64-arm-none-eabi.tar.xz" \
    -O /tmp/gcc-arm.tar.xz \
    && mkdir -p /opt/gcc-arm \
    && tar xf /tmp/gcc-arm.tar.xz -C /opt/gcc-arm --strip-components=1 \
    && rm /tmp/gcc-arm.tar.xz

ENV PATH="/opt/gcc-arm/bin:${PATH}"

WORKDIR /workspace
