FROM ubuntu:24.04

# Keep in sync with Dockerfile.build (single source of truth for the pinned
# ARM toolchain). GCC >= 14 is required for C++20 module scanning.
ARG ARM_GCC_VERSION=15.2.Rel1

# g++-15 (not 14): g++-14 miscompiles C++20 modules that include <cstddef> in
# the global module fragment. noble ships only g++-14, so use the PPA.
RUN apt-get update && apt-get install -y --no-install-recommends \
        software-properties-common \
    && add-apt-repository -y ppa:ubuntu-toolchain-r/test \
    && apt-get update && apt-get install -y --no-install-recommends \
        cmake make ninja-build wget xz-utils ca-certificates git \
        python3 python3-pip \
        gcc-15 g++-15 \
    && update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-15 100 \
    && update-alternatives --install /usr/bin/g++ g++ /usr/bin/g++-15 100 \
    && rm -rf /var/lib/apt/lists/*

# kconfiglib powers the .config -> config.cmake/stm32_autoconf.h generation
# (sdk/scripts/kconfig/genconfig.py, #63). Keep the pin in sync with
# Dockerfile.build. PEP 668 (Ubuntu 24.04) requires --break-system-packages.
RUN pip3 install --no-cache-dir --break-system-packages kconfiglib==14.1.0

# Match the ARM toolchain to the image's host architecture (multi-arch: x86_64
# on amd64, aarch64 on arm64). Download from the Arm CDN blob directly (the
# developer.arm.com redirect host does not resolve inside some Docker DNS
# setups). The blob path lowercases the version (15.2.Rel1 -> 15.2.rel1).
RUN ARM_GCC_LC="$(echo "${ARM_GCC_VERSION}" | tr '[:upper:]' '[:lower:]')" \
    && case "$(uname -m)" in \
         x86_64)  HOST_ARCH=x86_64 ;; \
         aarch64) HOST_ARCH=aarch64 ;; \
         *) echo "unsupported host arch $(uname -m)" >&2; exit 1 ;; \
       esac \
    && wget -q --retry-connrefused --tries=5 --timeout=120 --waitretry=5 \
    "https://armkeil.blob.core.windows.net/developer/files/downloads/gnu/${ARM_GCC_LC}/binrel/arm-gnu-toolchain-${ARM_GCC_LC}-${HOST_ARCH}-arm-none-eabi.tar.xz" \
    -O /tmp/gcc-arm.tar.xz \
    && mkdir -p /opt/gcc-arm \
    && tar xf /tmp/gcc-arm.tar.xz -C /opt/gcc-arm --strip-components=1 \
    && rm /tmp/gcc-arm.tar.xz

ENV PATH="/opt/gcc-arm/bin:${PATH}"

# Bake the pinned FreeRTOS-Kernel so builds never re-clone it per project (#47).
ARG FREERTOS_KERNEL_VERSION=V11.1.0
RUN git clone --depth 1 -b "${FREERTOS_KERNEL_VERSION}" \
    https://github.com/FreeRTOS/FreeRTOS-Kernel.git /opt/freertos-kernel
ENV FETCHCONTENT_SOURCE_DIR_FREERTOS_KERNEL=/opt/freertos-kernel

WORKDIR /workspace
