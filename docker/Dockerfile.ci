FROM ubuntu:24.04

# Keep in sync with Dockerfile.build (single source of truth for the pinned
# ARM toolchain). GCC >= 14 is required for C++20 module scanning.
ARG ARM_GCC_VERSION=15.2.Rel1

# g++-15 (not 14): g++-14 miscompiles C++20 modules that include <cstddef> in
# the global module fragment. noble ships only g++-14, so use the PPA.
RUN apt-get update && apt-get install -y --no-install-recommends \
        software-properties-common \
    && add-apt-repository -y ppa:ubuntu-toolchain-r/test \
    && apt-get update && apt-get install -y --no-install-recommends \
        cmake make ninja-build wget xz-utils ca-certificates git \
        gcc-15 g++-15 \
    && update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-15 100 \
    && update-alternatives --install /usr/bin/g++ g++ /usr/bin/g++-15 100 \
    && rm -rf /var/lib/apt/lists/*

# Download from the Arm CDN blob directly (the developer.arm.com redirect host
# does not resolve inside some Docker DNS setups). The blob path lowercases the
# version (15.2.Rel1 -> 15.2.rel1).
RUN ARM_GCC_LC="$(echo "${ARM_GCC_VERSION}" | tr '[:upper:]' '[:lower:]')" \
    && wget -q --retry-connrefused --tries=5 --timeout=120 --waitretry=5 \
    "https://armkeil.blob.core.windows.net/developer/files/downloads/gnu/${ARM_GCC_LC}/binrel/arm-gnu-toolchain-${ARM_GCC_LC}-x86_64-arm-none-eabi.tar.xz" \
    -O /tmp/gcc-arm.tar.xz \
    && mkdir -p /opt/gcc-arm \
    && tar xf /tmp/gcc-arm.tar.xz -C /opt/gcc-arm --strip-components=1 \
    && rm /tmp/gcc-arm.tar.xz

ENV PATH="/opt/gcc-arm/bin:${PATH}"

# Bake the pinned FreeRTOS-Kernel so builds never re-clone it per project (#47).
ARG FREERTOS_KERNEL_VERSION=V11.1.0
RUN git clone --depth 1 -b "${FREERTOS_KERNEL_VERSION}" \
    https://github.com/FreeRTOS/FreeRTOS-Kernel.git /opt/freertos-kernel
ENV FETCHCONTENT_SOURCE_DIR_FREERTOS_KERNEL=/opt/freertos-kernel

WORKDIR /workspace
