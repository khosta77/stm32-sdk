// Generated by sdk/cmake/version.cmake from `git describe` -- do not edit.
//
// Include as <version.hpp>; out/generated is on stm32_core's interface include
// path, so every project sees it. Safe next to `import`: this is a plain
// textual header with no STL includes, so it cannot collide with a module's
// global module fragment.

#ifndef STM32_GENERATED_VERSION_HPP_
#define STM32_GENERATED_VERSION_HPP_

namespace firmware {

// Full description, e.g. "v1.2.3", "v1.2.3-4-gabc1234", "v1.2.3-dirty", or
// "v0.0.0-untagged" when the project has no reachable tag.
inline constexpr const char *VERSION = "@STM32_PROJECT_VERSION@";

inline constexpr unsigned VERSION_MAJOR = @_stm32_version_major@;
inline constexpr unsigned VERSION_MINOR = @_stm32_version_minor@;
inline constexpr unsigned VERSION_PATCH = @_stm32_version_patch@;

// False when no tag was reachable -- the numbers above are then all zero and
// mean "unknown", not "release 0.0.0".
inline constexpr bool VERSION_TAGGED = @_stm32_version_tagged@;

// True when tracked files had uncommitted changes at configure time. Untracked
// files do not count -- this mirrors `git describe --dirty`.
inline constexpr bool VERSION_DIRTY = @_stm32_version_dirty@;

}  // namespace firmware

#endif  // STM32_GENERATED_VERSION_HPP_
