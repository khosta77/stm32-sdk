# STM32-SDK configuration tree root (#63, v0.2.2).
#
# Processed by kconfiglib (sdk/scripts/kconfig/genconfig.py) at CMake
# configure time. The project-local `.config` file is the single source of
# truth for firmware content; `stmproject.toml` keeps only workspace/tooling
# concerns (SDK ref, chip, flash tool). Chip selection deliberately lives
# OUTSIDE this tree (west model): the tree ships with the SDK and its future
# per-chip dependencies hang off the generated fragment below.

mainmenu "STM32-SDK firmware configuration"

# Generated by sdk/cmake/kconfig.cmake from STM32_CHIP before genconfig runs
# (out/generated/Kconfig.chip). Optional so `stmtool config` can open the
# menu before the first build.
osource "$(STM32_KCONFIG_CHIP_FRAGMENT)"

menu "Core"

config STM32_HSE_VALUE
	int "External crystal (HSE) frequency, Hz"
	default 8000000
	range 4000000 26000000
	help
	  Frequency of the external high-speed oscillator. Emitted as the
	  HSE_VALUE compile definition consumed by the CMSIS clock setup.
	  STM32F4 accepts 4-26 MHz crystals.

choice
	prompt "Floating-point ABI"
	default STM32_FLOAT_ABI_HARD
	help
	  Selects -mfloat-abi for the whole build. "hard" and "softfp" enable
	  the FPv4-SP FPU and the FreeRTOS ARM_CM4F port; "soft" uses pure
	  software floating point and the ARM_CM4 port.

config STM32_FLOAT_ABI_HARD
	bool "hard"

config STM32_FLOAT_ABI_SOFTFP
	bool "softfp"

config STM32_FLOAT_ABI_SOFT
	bool "soft"

endchoice

endmenu

source "drivers/Kconfig"
source "rtos/Kconfig"
source "sensors/Kconfig"
source "storage/Kconfig"
source "system/Kconfig"
source "testing/Kconfig"
